{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "KafePlat",
  "version": "1.0.0",
  "identifier": "uz.securehub.kafeplat",
  "build": {
    "beforeDevCommand": "cd /home/kali/Desktop/projects/Django/Kafe/frontend && npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "/home/kali/Desktop/projects/Django/Kafe/frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "KafePlat",
        "width": 1366,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "minWidth": 1024,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/kafe-api.exe",
      ".env"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {},
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  }
}
