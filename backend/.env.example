# ===== KAFE IDENTITY (Har bir mijoz uchun o'zgartiriladi) =====
CAFE_NAME=MyCafe
CAFE_FULL_NAME=MyCafe restoran
CAFE_ADDRESS=Shahar, Tuman
CAFE_PHONE=+998 90 000 00 00
CAFE_WEBSITE=mycafe.example.com

# API Server Configuration
PORT=8080
GIN_MODE=debug

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kafe_db

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_here

# Third-Party Integrations
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_REPORT_CHAT_IDS=your_report_chat_id_here,optional_second_chat_id
PRINTER_TOKEN=your_printer_access_token_here

# Client Configuration
API_URL=localhost:8080
